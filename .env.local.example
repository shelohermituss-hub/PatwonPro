# Supabase — pran valè sa yo nan Project Settings > API sou supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Peman mobil (MonCash + NatCash) — gateway "PLOP PLOP" (Pay'm), yon sèl
# API pou de founisè yo (https://plopplop.solutionip.app). Client_id
# sèlman nesesè pou kreye/verifye yon peman — pa gen client_secret pou
# API sa a (li rezève pou API retrè machann, ki pa entegre kounye a).
# Preferans reyèl la se paj /admin/settings (Sipè Admin) — yon Client ID
# antre la a pran priyorite. Varyab sa a se sèlman yon defo/repli lè
# paramèt platfòm nan vid. Gade src/lib/payments/gateway.ts.
PAYMENT_GATEWAY_CLIENT_ID=

# Twilio — rapèl abònman pa SMS/WhatsApp (bouton "Relanse" sou
# /admin/subscriptions). Gade src/lib/admin/actions/sendSubscriptionReminder.ts.
# TWILIO_SMS_FROM se yon nimewo Twilio nòmal ; TWILIO_WHATSAPP_FROM se yon
# nimewo WhatsApp Business apwouve pa Twilio (Sandbox oswa pwodiksyon).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Notifikasyon push (Web Push standard, VAPID) — jenere yon sèl fwa ak
# `npx web-push generate-vapid-keys`. Gade src/lib/push/{subscribe,send}.ts.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@patwonpro.com

# Sekrè pataje ant pg_cron (Supabase) ak POST /api/push/dispatch — jenere
# yon chèn ale-twa alèa (`openssl rand -hex 32`), konfigire menm valè a
# nan `net.http_post` header ki nan fonksyon SQL la.
PUSH_DISPATCH_SECRET=
