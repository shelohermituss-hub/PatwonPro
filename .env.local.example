# Supabase — pran valè sa yo nan Project Settings > API sou supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MonCash (Digicel) — https://moncashbutton.digicelgroup.com
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_ENV=sandbox
# Shared secret for /api/webhooks/moncash — see that route's file header:
# MonCash's public docs don't document a real webhook signature scheme,
# so this just gates the route until you have one to replace it with.
MONCASH_WEBHOOK_SECRET=

# NatCash (Natcom) — pa gen dokiman piblik, gade src/lib/payments/natcash.ts
NATCASH_CLIENT_ID=
NATCASH_CLIENT_SECRET=
NATCASH_ENV=sandbox
NATCASH_WEBHOOK_SECRET=
